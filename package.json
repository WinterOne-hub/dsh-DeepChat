{
  "name": "dsh-private-chat-prototype",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.0-rc.2 <0.3.0 || >=0.2.2-rc.3 <0.2.2"
  },
  "scripts": {
    "test": "node --test checks/offline.js"
  },
  "dependencies": {
    "jose": "6.2.12",
    "qrcode-generator": "2.0.4"
  },
  "bundleDependencies": [
    "jose",
    "qrcode-generator"
  ],
  "description": "dsh-DeepChat: encrypted chat, file sharing and AI conversations for DeepSeek Harness / DSH 加密聊天与材料分享插件",
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/browser.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "SECURITY.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "author": "WinterOne-hub",
  "homepage": "https://github.com/WinterOne-hub/dsh-DeepChat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WinterOne-hub/dsh-DeepChat.git"
  },
  "bugs": {
    "url": "https://github.com/WinterOne-hub/dsh-DeepChat/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "deepchat",
    "chat",
    "messaging",
    "encrypted-chat",
    "file-sharing",
    "self-hosted",
    "ai",
    "llm",
    "聊天",
    "加密聊天",
    "材料分享"
  ]
}
